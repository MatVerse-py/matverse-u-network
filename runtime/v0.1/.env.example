# Copie para .env e troque antes de qualquer rede pública.
MATVERSE_API_KEY=change-me-before-use
MATVERSE_ENV=local
LEDGER_PATH=/data/ledger/events.jsonl
MAX_CVAR=0.05
MIN_PSI=0.85
MIN_OMEGA=0.85
RELAY_ROOM_TTL_SECONDS=900
RELAY_MAX_MESSAGE_BYTES=65536
POSTGRES_USER=matverse
POSTGRES_PASSWORD=local-dev-password-change-me
POSTGRES_DB=matverse
